{
  // Configuration for the devine-utils-ci quality gates.
  //
  // A project may only *tighten* the built-in budgets. Raising a threshold,
  // switching a file-length profile or excluding a path from a hard budget is
  // a configuration error, not a warning.
  "ignore": {
    "paths": [
      "target/**",
      "vendor/**"
    ],
    // The usage text is a verbatim copy of the Go original's help block, and
    // that block names the very markers this gate scans for. Only the file
    // holding the command list is exempt; the rest of the sources are still
    // scanned line by line.
    "bugs": {
      "paths": ["src/usage/commands.rs"]
    }
  },
  "file-length": {
    "profiles": {
      "source": { "warn": 300, "max": 450 }
    }
  },
  "complexity": {
    "warn": 12,
    "max": 18
  }
}
